<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900"
        Height="600"
        Title="MyAvaloniaApp">

    <Window.Styles>
        <!-- Tasten dunkler und besser lesbar -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#BDBFAE"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A9AB98"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8F917F"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://MyAvaloniaApp/Assets/factory_plan.png"
               Stretch="None"/>

        <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900">

            <!-- Aktuelle Pose des Roboters (rot) -->
            <TextBlock Text="{Binding PositionText}"
                       Foreground="Red"
                       FontSize="16"
                       Canvas.Left="50"
                       Canvas.Top="42"/>

            <!-- Die vier Produktionslinien mit Legosteinen: weißes Rechteck (160 x 60) mit Förderband,
                 um den Winkel der Linie gedreht (rot 90, blau 270, gelb/grün 0) -->
            <Grid Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}"
                  Canvas.Left="{Binding ProductionRedX}" Canvas.Top="{Binding ProductionRedY}"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding ProductionRedAngle}"/>
                </Grid.RenderTransform>
                <Border Background="White"/>
                <Image Source="avares://MyAvaloniaApp/Assets/productionline_red.png" Stretch="Fill"
                       Width="140" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>
            <Grid Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}"
                  Canvas.Left="{Binding ProductionBlueX}" Canvas.Top="{Binding ProductionBlueY}"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding ProductionBlueAngle}"/>
                </Grid.RenderTransform>
                <Border Background="White"/>
                <Image Source="avares://MyAvaloniaApp/Assets/productionline_blue.png" Stretch="Fill"
                       Width="140" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>
            <Grid Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}"
                  Canvas.Left="{Binding ProductionYellowX}" Canvas.Top="{Binding ProductionYellowY}"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding ProductionYellowAngle}"/>
                </Grid.RenderTransform>
                <Border Background="White"/>
                <Image Source="avares://MyAvaloniaApp/Assets/productionline_yellow.png" Stretch="Fill"
                       Width="140" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>
            <Grid Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}"
                  Canvas.Left="{Binding ProductionGreenX}" Canvas.Top="{Binding ProductionGreenY}"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding ProductionGreenAngle}"/>
                </Grid.RenderTransform>
                <Border Background="White"/>
                <Image Source="avares://MyAvaloniaApp/Assets/productionline_green.png" Stretch="Fill"
                       Width="140" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>

            <!-- Recycling-Linie in der Mitte: Bild mit Förderband in allen vier Farben (160 x 60) -->
            <Image Source="avares://MyAvaloniaApp/Assets/productionline_recycle.png" Stretch="Fill"
                   Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}"
                   Canvas.Left="{Binding ProductionRecycleX}" Canvas.Top="{Binding ProductionRecycleY}"
                   RenderTransformOrigin="50%,50%">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding ProductionRecycleAngle}"/>
                </Image.RenderTransform>
            </Image>

            <!-- Lieferlinie am oberen Rand: Bild mit den drei Feldern For Recycling / Delivery / To Customers -->
            <Image Source="avares://MyAvaloniaApp/Assets/Versandlinie.png" Stretch="Fill"
                   Width="{Binding DeliveryStripWidth}" Height="{Binding DeliveryStripHeight}"
                   Canvas.Left="{Binding DeliveryStripX}" Canvas.Top="{Binding DeliveryStripY}"/>

            <!-- Legosteine: ItemsControl mit Canvas, Pose und Größe kommen aus dem LegoBrickViewModel -->
            <ItemsControl ItemsSource="{Binding Bricks}" Width="900" Height="600" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegoBrickViewModel">
                        <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"
                                   RenderTransformOrigin="50%,50%">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="{Binding Angle}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Der Roboter -->
            <Image x:Name="RobotImage"
                   Source="avares://MyAvaloniaApp/Assets/robot_platform.png"
                   Stretch="Fill"
                   Width="{Binding RobotWidth}"
                   Height="{Binding RobotHeight}"
                   Canvas.Left="{Binding RobotX}"
                   Canvas.Top="{Binding RobotY}"
                   RenderTransformOrigin="50%,50%">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding RobotAngle}"/>
                </Image.RenderTransform>
            </Image>

            <!-- Anzeige der gelieferten Steine pro Farbe -->
            <TextBlock Text="Order" FontSize="22" FontWeight="Bold" Foreground="Black" Canvas.Left="630" Canvas.Top="28"/>
            <TextBlock Text="Delivered" FontSize="13" FontWeight="Bold" Foreground="Black" Canvas.Left="801" Canvas.Top="36"/>
            <Border Canvas.Left="630" Canvas.Top="56" Width="74" Height="30" CornerRadius="3" Background="#FFE000">
                <TextBlock Text="yellow" FontWeight="Bold" Foreground="Black" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="802" Canvas.Top="56" Width="70" Height="30" CornerRadius="3"
                    BorderBrush="Gray" BorderThickness="1" Background="#F7F7EC">
                <TextBlock Text="{Binding YellowDelivered}" Foreground="Black" FontSize="14"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Border>
            <Border Canvas.Left="630" Canvas.Top="92" Width="74" Height="30" CornerRadius="3" Background="#4169E1">
                <TextBlock Text="blue" FontWeight="Bold" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="802" Canvas.Top="92" Width="70" Height="30" CornerRadius="3"
                    BorderBrush="Gray" BorderThickness="1" Background="#F7F7EC">
                <TextBlock Text="{Binding BlueDelivered}" Foreground="Black" FontSize="14"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Border>
            <Border Canvas.Left="630" Canvas.Top="128" Width="74" Height="30" CornerRadius="3" Background="#B22222">
                <TextBlock Text="red" FontWeight="Bold" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="802" Canvas.Top="128" Width="70" Height="30" CornerRadius="3"
                    BorderBrush="Gray" BorderThickness="1" Background="#F7F7EC">
                <TextBlock Text="{Binding RedDelivered}" Foreground="Black" FontSize="14"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Border>
            <Border Canvas.Left="630" Canvas.Top="164" Width="74" Height="30" CornerRadius="3" Background="#228B22">
                <TextBlock Text="green" FontWeight="Bold" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="802" Canvas.Top="164" Width="70" Height="30" CornerRadius="3"
                    BorderBrush="Gray" BorderThickness="1" Background="#F7F7EC">
                <TextBlock Text="{Binding GreenDelivered}" Foreground="Black" FontSize="14"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Border>

            <!-- Meldungen: Auslieferung und Ergebnis des Undock-Buttons -->
            <TextBlock Text="{Binding OrderInfo}" Canvas.Left="628" Canvas.Top="262" Width="250"
                       TextWrapping="Wrap" FontSize="14" Foreground="#1F5F5F"/>
            <TextBlock Text="{Binding UndockInfo}" Canvas.Left="628" Canvas.Top="296" Width="250"
                       TextWrapping="Wrap" FontSize="13" Foreground="Black"/>

            <!-- Start / Stop für die Pendelbewegung der Legosteine -->
            <Button x:Name="StartButton" Canvas.Left="628" Canvas.Top="386" Width="120" Height="30"
                    Content="Start" HorizontalContentAlignment="Center" Click="StartTimer_Click"/>
            <Button x:Name="StopButton" Canvas.Left="756" Canvas.Top="386" Width="120" Height="30"
                    Content="Stop" HorizontalContentAlignment="Center" Click="StopTimer_Click"/>
            <Button x:Name="GoToDelivery" Canvas.Left="756" Canvas.Top="346" Width="120" Height="30"
                    Content="GoToDelivery" HorizontalContentAlignment="Center" Click="GoToDelivery_Click"/>
            <Button x:Name="GoToLine" Canvas.Left="756" Canvas.Top="306" Width="120" Height="30"
                    Content="GoToLine" HorizontalContentAlignment="Center" Click="GoToLine_Click"/>        

            <!-- Move = Dauerbewegung bis Stop, Step = ein Schritt pro Klick -->
            <RadioButton x:Name="MoveRadio" GroupName="Mode" Content="Move" Canvas.Left="658" Canvas.Top="458"/>
            <RadioButton x:Name="StepRadio" GroupName="Mode" Content="Step" Canvas.Left="658" Canvas.Top="494"
                         IsChecked="{Binding IsStepMode}"/>
            <Button x:Name="UndockButton" Canvas.Left="660" Canvas.Top="528" Width="74" Height="30"
                    Content="Undock" HorizontalContentAlignment="Center" Click="UndockButton_Click"/>

            <!-- Steuerung: 8 Richtungen, Stop in der Mitte, Drehen links/rechts und Winkel zurücksetzen -->
            <Grid Canvas.Left="750" Canvas.Top="440" Width="132"
                  ColumnDefinitions="44,44,44" RowDefinitions="36,36,36,36">
                <Grid.Styles>
                    <Style Selector="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </Grid.Styles>

                <Button x:Name="UpLeftButton"    Grid.Row="0" Grid.Column="0" Content="↖" Click="MoveUpLeft_Click"/>
                <Button x:Name="UpButton"        Grid.Row="0" Grid.Column="1" Content="↑" Click="MoveUp_Click"/>
                <Button x:Name="UpRightButton"   Grid.Row="0" Grid.Column="2" Content="↗" Click="MoveUpRight_Click"/>

                <Button x:Name="LeftButton"      Grid.Row="1" Grid.Column="0" Content="←" Click="MoveLeft_Click"/>
                <Button x:Name="StopRobotButton" Grid.Row="1" Grid.Column="1" Content="■" Click="Stop_Click"/>
                <Button x:Name="RightButton"     Grid.Row="1" Grid.Column="2" Content="→" Click="MoveRight_Click"/>

                <Button x:Name="DownLeftButton"  Grid.Row="2" Grid.Column="0" Content="↙" Click="MoveDownLeft_Click"/>
                <Button x:Name="DownButton"      Grid.Row="2" Grid.Column="1" Content="↓" Click="MoveDown_Click"/>
                <Button x:Name="DownRightButton" Grid.Row="2" Grid.Column="2" Content="↘" Click="MoveDownRight_Click"/>

                <Button x:Name="RotateLeftButton"  Grid.Row="3" Grid.Column="0" Content="↺" Click="MoveRotateLeft_Click"/>
                <Button x:Name="ResetRotationButton" Grid.Row="3" Grid.Column="1" Content="0°" Click="ResetRotation_Click"/>
                <Button x:Name="RotateRightButton" Grid.Row="3" Grid.Column="2" Content="↻" Click="MoveRotateRight_Click"/>
            </Grid>

        </Canvas>
    </Grid>

</Window>
